# Terraform working directories and state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan

# Local variable files can hold IPs, key names and other personal settings.
# terraform.tfvars.example is committed instead.
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files are committed for the root configuration only; modules float.
modules/**/.terraform.lock.hcl

# Editors and OS
.idea/
.vscode/
.DS_Store
